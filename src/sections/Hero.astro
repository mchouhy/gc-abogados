---
import ArrowRightSvg from "../components/ArrowRightSvg.astro";
---

<section class="relative mx-2 min-h-svh sm:mx-auto sm:max-w-7xl md:pt-0">
  <article
    class="z-10 flex min-h-svh flex-col justify-start gap-y-10 py-24 lg:py-52"
  >
    <header>
      <h1 class="relative flex flex-col">
        <span
          class="hero-h1-typo invisible text-[1.75rem] leading-[1.1] font-bold tracking-tight text-primary sm:mb-4 sm:text-5xl md:text-7xl lg:text-8xl"
          aria-hidden="true">AQUÍ NO ERES UN</span
        >
        <span
          class="hero-h1-typo2 invisible mb-2 pt-2 text-[clamp(2.5rem,8vw,4rem)] leading-[0.9] font-black tracking-tighter sm:text-7xl md:text-9xl lg:text-[clamp(6rem,10vw,12rem)]"
          aria-hidden="true">EXPEDIENTE</span
        >
        <span class="absolute inset-0 flex flex-col">
          <span
            class="hero-h1-typo animate-hero relative text-[1.75rem] leading-[1.1] font-bold tracking-tight text-primary sm:mb-4 sm:text-5xl md:text-7xl lg:text-8xl"
          >
            AQUÍ <span id="tw-line1" aria-hidden="true"></span>
          </span>
          <span
            class="hero-h1-typo2 animate-hero animate-hero-delay-1 relative mb-2 inline-block pt-2 text-[clamp(2.5rem,8vw,4rem)] leading-[0.9] font-black tracking-tighter sm:text-7xl md:text-9xl lg:text-[clamp(6rem,10vw,12rem)]"
          >
            <span
              id="tw-line2"
              class="bg-[linear-gradient(to_right,rgba(115,56,56,0.94),rgba(139,69,69,0.85),rgba(139,69,69,0.75))] bg-clip-text text-transparent"
              aria-hidden="true"></span><span
              id="tw-cursor"
              class="tw-cursor"
              aria-hidden="true"></span>
          </span>
        </span>
      </h1>
      <span class="sr-only"
        >Aquí no eres un expediente. Aquí eres una persona.</span
      >
      <p
        class="animate-hero animate-hero-delay-2 text-normal leading-relaxed font-medium text-pretty text-primary mobl:text-lg sm:text-lg md:text-xl lg:text-2xl xl:text-3xl"
      >
        Hablas directamente con nosotros. <span
          class="inline text-primary mobm:block sm:inline"
        >
          Precio cerrado sin sorpresas.</span
        >
        <span class="block text-primary"
          >Te respondemos hoy, no la semana que viene.</span
        >
      </p>
    </header>
    <footer
      class="animate-hero animate-hero-delay-3 flex w-full flex-col gap-4 sm:flex-row sm:items-center sm:gap-6"
    >
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20c%C3%B3mo%20pueden%20ayudarme."
        class="group box-border flex w-full items-center justify-center rounded-sm border border-transparent bg-[linear-gradient(to_right,rgba(115,56,56,1),rgba(139,69,69,0.9),rgba(139,69,69,0.85))] px-2 py-4 text-center text-base font-bold text-white shadow-lg transition-all duration-300 hover:bg-[#733838] hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545] sm:max-w-80 sm:px-6 sm:py-5 sm:text-lg"
        >WHATSAPP
        <ArrowRightSvg
          className="ml-2 transition-transform duration-300 group-hover:translate-x-2"
        />
      </a>
      <a
        href="#services"
        class="group box-border flex w-full items-center justify-center rounded-sm border border-gray-200 bg-white px-2 py-4 text-center text-base font-medium text-gray-900 shadow-lg transition-all duration-300 hover:bg-gray-50 hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545] sm:max-w-80 sm:px-6 sm:py-5 sm:text-lg"
      >
        TRÁMITES
        <ArrowRightSvg
          className="ml-2 transition-transform duration-300 group-hover:translate-x-2"
        />
      </a>
    </footer>
  </article>
</section>

<script>
  (function () {
    const DELETE_SPEED = 100;
    const TYPE_SPEED = 110;
    const PAUSE_DURATION = 2000;
    const INITIAL_PAUSE = 1500;

    const line1El = document.getElementById("tw-line1");
    const line2El = document.getElementById("tw-line2");
    const cursorEl = document.getElementById("tw-cursor");

    if (!line1El || !line2El || !cursorEl) return;

    const el1 = line1El;
    const el2 = line2El;
    const cursor = cursorEl;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reducedMotion) {
      el1.textContent = "NO ERES UN";
      el2.textContent = "EXPEDIENTE";
      cursor.style.display = "none";
      return;
    }

    cursor.style.display = "";

    const PAIRS = [
      { l1: "NO ERES UN", l2: "EXPEDIENTE" },
      { l1: "ERES UNA", l2: "PERSONA" },
    ];
    let pairIndex = 0;
    let timeoutId: ReturnType<typeof setTimeout> | null = null;

    function sleep(ms: number): Promise<void> {
      return new Promise((resolve) => {
        timeoutId = setTimeout(resolve, ms);
      });
    }

    function waitForVisible(): Promise<void> {
      if (document.visibilityState === "visible") return Promise.resolve();
      return new Promise<void>((resolve) => {
        const handler = () => {
          if (document.visibilityState === "visible") {
            document.removeEventListener("visibilitychange", handler);
            resolve();
          }
        };
        document.addEventListener("visibilitychange", handler);
      });
    }

    function isCharSpan(node: ChildNode): boolean {
      return node.nodeType === 1 && node !== cursor;
    }

    function getCharCount(): number {
      let count = 0;
      for (const n of el1.childNodes) if (isCharSpan(n)) count++;
      for (const n of el2.childNodes) if (isCharSpan(n)) count++;
      return count;
    }

    function deleteLastChar(): boolean {
      for (let i = el2.childNodes.length - 1; i >= 0; i--) {
        const n = el2.childNodes[i];
        if (isCharSpan(n)) {
          el2.removeChild(n);
          return true;
        }
      }
      for (let i = el1.childNodes.length - 1; i >= 0; i--) {
        const n = el1.childNodes[i];
        if (isCharSpan(n)) {
          el1.removeChild(n);
          return true;
        }
      }
      return false;
    }

    function positionCursorAtEnd() {
      if (cursor.parentNode) cursor.parentNode.removeChild(cursor);
      for (const n of el2.childNodes) {
        if (isCharSpan(n)) {
          el2.appendChild(cursor);
          return;
        }
      }
      el1.appendChild(cursor);
    }

    function renderInitial(l1Text: string, l2Text: string) {
      el1.textContent = "";
      for (const ch of l1Text) {
        const s = document.createElement("span");
        s.textContent = ch;
        s.className = "tw-char in";
        el1.appendChild(s);
      }
      el2.textContent = "";
      for (const ch of l2Text) {
        const s = document.createElement("span");
        s.textContent = ch;
        s.className = "tw-char in";
        el2.appendChild(s);
      }
    }

    async function typeChar(ch: string, targetEl: HTMLElement) {
      const span = document.createElement("span");
      span.textContent = ch;
      span.className = "tw-char";
      targetEl.appendChild(span);
      positionCursorAtEnd();

      await waitForVisible();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          span.classList.add("in");
        });
      });
      await sleep(TYPE_SPEED);
    }

    async function deleteAll() {
      while (getCharCount() > 0) {
        await waitForVisible();
        deleteLastChar();
        positionCursorAtEnd();
        await sleep(DELETE_SPEED);
      }
    }

    async function typeAll(l1Text: string, l2Text: string) {
      for (const ch of l1Text) {
        await typeChar(ch, el1);
      }
      for (const ch of l2Text) {
        await typeChar(ch, el2);
      }
    }

    renderInitial(PAIRS[pairIndex].l1, PAIRS[pairIndex].l2);
    positionCursorAtEnd();

    async function runCycle() {
      await sleep(INITIAL_PAUSE);

      while (true) {
        await deleteAll();

        pairIndex = (pairIndex + 1) % PAIRS.length;
        await typeAll(PAIRS[pairIndex].l1, PAIRS[pairIndex].l2);
        await sleep(PAUSE_DURATION);

        await deleteAll();

        pairIndex = (pairIndex + 1) % PAIRS.length;
        await typeAll(PAIRS[pairIndex].l1, PAIRS[pairIndex].l2);
        await sleep(PAUSE_DURATION);
      }
    }

    runCycle();

    document.addEventListener("astro:before-swap", () => {
      if (timeoutId !== null) {
        clearTimeout(timeoutId);
      }
    });
  })();
</script>
