---
import Logo from "../components/Logo.astro";
---

<footer class="bg-secondary px-4 py-12 sm:px-6 sm:py-16 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div
      class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-12 md:grid-cols-4 lg:gap-16"
    >
      <div class="flex flex-col gap-4">
        <a href="/" aria-label="Ataria Abogados — Inicio">
          <Logo class="text-lg text-white" />
        </a>
        <p class="max-w-xs text-sm leading-relaxed text-white/60">
          Despacho especializado en extranjería e inmigración en España.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold tracking-wider text-white/80">
          Navegación
        </h3>
        <ul class="flex flex-col gap-2">
          <li>
            <a
              href="#services"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >Trámites</a
            >
          </li>
          <li>
            <a
              href="#process"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >Cómo trabajamos</a
            >
          </li>
          <li>
            <a
              href="#contact"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >Contacto</a
            >
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold tracking-wider text-white/80">
          Contacto
        </h3>
        <ul class="flex flex-col gap-2">
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/34613168703"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >WhatsApp</a
            >
          </li>
          <li>
            <a
              href="mailto:TODO@atariaabogados.com"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >TODO: email real</a
            >
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold tracking-wider text-white/80">
          Legal
        </h3>
        <ul class="flex flex-col gap-2">
          <li>
            <a
              href="/aviso-legal"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >Aviso legal</a
            >
          </li>
          <li>
            <a
              href="/politica-privacidad"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >Política de privacidad</a
            >
          </li>
          <li>
            <a
              href="/politica-cookies"
              class="text-sm text-white/60 transition-colors duration-200 hover:text-white"
              >Política de cookies</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center gap-2 border-t border-white/10 pt-8 sm:flex-row sm:justify-between"
    >
      <p class="text-xs text-white/40">
        &copy; 2026 Ataria Abogados. Todos los derechos reservados.
      </p>
      <p class="text-xs text-white/40">
        TODO: CIF/NIF · Dirección · Datos colegiales
      </p>
    </div>
  </div>
</footer>
