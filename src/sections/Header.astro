---
import Logo from "../components/Logo.astro";
import ArrowRightSvg from "../components/ArrowRightSvg.astro";
---

<nav
  class="fixed inset-x-0 top-0 z-20 border-b border-gray-200/60 bg-[#f8f9fa]/90 backdrop-blur-md"
  aria-label="Navegación principal"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6"
  >
    <a href="/" class="flex items-center" aria-label="Ataria Abogados — Inicio">
      <Logo />
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      <li>
        <a
          href="#services"
          class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-secondary"
          >Trámites</a
        >
      </li>
      <li>
        <a
          href="#process"
          class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-secondary"
          >Cómo trabajamos</a
        >
      </li>
      <li>
        <a
          href="#contact"
          class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-secondary"
          >Contacto</a
        >
      </li>
      <li>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios."
          class="rounded-sm bg-[#8b4545] px-5 py-2 text-sm font-semibold text-white transition-all duration-200 hover:bg-[#733838] hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545]"
          >Cuéntanos tu caso</a
        >
      </li>
    </ul>

    <button
      type="button"
      class="hamburger-btn rounded-lg p-2 text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545] md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <div class="flex h-full flex-col">
    <header class="flex items-center px-4 py-3 sm:px-6">
      <a
        href="/"
        class="flex items-center"
        aria-label="Ataria Abogados — Inicio"
      >
        <Logo dark />
      </a>
    </header>
    <div class="flex flex-1 flex-col justify-center px-6 pb-8">
      <div class="flex flex-col">
        <a href="#services" class="mobile-menu-link"
          >Trámites
          <ArrowRightSvg className="shrink-0" />
        </a>
        <a href="#process" class="mobile-menu-link"
          >Cómo trabajamos
          <ArrowRightSvg className="shrink-0" />
        </a>
        <a href="#contact" class="mobile-menu-link"
          >Contacto
          <ArrowRightSvg className="shrink-0" />
        </a>
      </div>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios."
        class="mt-8 block rounded-sm bg-white px-8 py-3 text-center text-[1.3rem] font-semibold text-secondary transition-all duration-200 hover:bg-white/90 hover:shadow-lg"
        >CUÉNTANOS TU CASO</a
      >
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const btn = document.querySelector<HTMLButtonElement>(
      '[aria-controls="mobile-menu"]',
    );
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    let isOpen = false;
    let savedScrollY = 0;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function lockScroll() {
      savedScrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.width = "100%";
    }

    function unlockScroll() {
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      window.scrollTo(0, savedScrollY);
    }

    function openMenu() {
      isOpen = true;
      lockScroll();
      menu!.classList.add("is-open");
      menu!.setAttribute("aria-hidden", "false");
      btn!.setAttribute("aria-expanded", "true");
      btn!.setAttribute("aria-label", "Cerrar menú");
    }

    function closeMenu(immediateUnlock: boolean) {
      isOpen = false;
      menu!.classList.remove("is-open");
      menu!.setAttribute("aria-hidden", "true");
      btn!.setAttribute("aria-expanded", "false");
      btn!.setAttribute("aria-label", "Abrir menú");

      if (immediateUnlock) {
        window.scrollTo(0, savedScrollY);
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.width = "";
      } else {
        const delay = reducedMotion ? 0 : 400;
        setTimeout(() => {
          if (!isOpen) unlockScroll();
        }, delay);
      }
    }

    btn.addEventListener("click", () => {
      if (isOpen) closeMenu(false);
      else openMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu(true);
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) closeMenu(false);
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
