---
import Logo from "../components/Logo.astro";
---

<nav
  class="fixed inset-x-0 top-0 z-20 border-b border-gray-200/60 bg-[#f8f9fa]/90 backdrop-blur-md"
  aria-label="Navegación principal"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6"
  >
    <a href="/" class="flex items-center" aria-label="Ataria Abogados — Inicio">
      <Logo />
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      <li>
        <a
          href="#services"
          class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-secondary"
          >Trámites</a
        >
      </li>
      <li>
        <a
          href="#process"
          class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-secondary"
          >Cómo trabajamos</a
        >
      </li>
      <li>
        <a
          href="#contact"
          class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-secondary"
          >Contacto</a
        >
      </li>
      <li>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios."
          class="rounded-sm bg-[#8b4545] px-5 py-2 text-sm font-semibold text-white transition-all duration-200 hover:bg-[#733838] hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545]"
          >Cuéntanos tu caso</a
        >
      </li>
    </ul>

    <button
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545] md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-gray-200/60 bg-[#f8f9fa]/95 backdrop-blur-md md:hidden"
  >
    <div class="space-y-1 px-4 pt-2 pb-4">
      <a
        href="#services"
        class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 hover:text-secondary"
        >Trámites</a
      >
      <a
        href="#process"
        class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 hover:text-secondary"
        >Cómo trabajamos</a
      >
      <a
        href="#contact"
        class="block rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 hover:text-secondary"
        >Contacto</a
      >
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios."
        class="mt-2 block rounded-full bg-[#8b4545] px-5 py-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-[#733838]"
        >Cuéntanos tu caso</a
      >
    </div>
  </div>
</nav>

<script>
  function setupMobileMenu() {
    const btn = document.querySelector<HTMLButtonElement>(
      '[aria-controls="mobile-menu"]',
    );
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");

      if (!expanded) {
        const icon = btn.querySelector("svg");
        if (icon) {
          icon.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>';
        }
        btn.setAttribute("aria-label", "Cerrar menú");
      } else {
        const icon = btn.querySelector("svg");
        if (icon) {
          icon.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>';
        }
        btn.setAttribute("aria-label", "Abrir menú");
      }
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        const icon = btn.querySelector("svg");
        if (icon) {
          icon.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>';
        }
        btn.setAttribute("aria-label", "Abrir menú");
      });
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
