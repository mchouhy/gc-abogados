---
import FeatureBox from "../components/FeatureBox.astro";
import MessageSvg from "../components/MessageSvg.astro";
import EuroSvg from "../components/EuroSvg.astro";
import LightningSvg from "../components/LightningSvg.astro";
import NotebookSvg from "../components/NotebookSvg.astro";

const features = [
  {
    svg: MessageSvg,
    title: "Contacto directo",
    description:
      "Hablas con nosotros, no con asistentes. Escuchamos tu caso sin prisa.",
  },
  {
    svg: EuroSvg,
    title: "Precio Cerrado",
    description: "Te damos el precio final desde el minuto uno. Sin sorpresas.",
  },
  {
    svg: LightningSvg,
    title: "Respuesta Rápida",
    description: "Respondemos el mismo día. Tu tiempo es valioso.",
  },
  {
    svg: NotebookSvg,
    title: "Estrategia Personal",
    description: "Cada caso es único. Creamos un plan adaptado a ti.",
  },
];
---

<section id="process" class="px-4 pt-20 pb-32 sm:mx-auto sm:max-w-7xl">
  <div class="flex flex-col items-start gap-y-2 sm:items-center">
    <h2
      class="animate-on-scroll text-start text-sm font-semibold tracking-widest text-secondary sm:text-base"
    >
      PROCESO
    </h2>
    <h3
      class="animate-on-scroll animate-on-scroll-delay-1 text-start text-2xl font-bold sm:text-3xl md:text-4xl lg:text-5xl"
    >
      Cómo trabajamos
    </h3>
    <p
      class="animate-on-scroll animate-on-scroll-delay-2 mb-4 max-w-4xl text-sm leading-relaxed font-light text-gray-700 sm:mb-14 sm:text-base md:text-lg lg:text-xl"
    >
      Desde el primer contacto hasta la resolución de tu caso, te guiamos paso a
      paso.
    </p>
  </div>
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4 lg:gap-8">
    {
      features.map((item, i) => {
        const delayClass = `animate-on-scroll-delay-${Math.min(i + 1, 4)}`;
        return (
          <div class:list={["animate-on-scroll", delayClass]}>
            <FeatureBox
              svg={item.svg}
              title={item.title}
              description={item.description}
            />
          </div>
        );
      })
    }
  </div>
</section>
