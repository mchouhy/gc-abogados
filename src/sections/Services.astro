---
import Card from "../components/Card.astro";
import WorldSvg from "../components/WorldSvg.astro";
import SchoolSvg from "../components/SchoolSvg.astro";
import FamilySvg from "../components/FamilySvg.astro";
import FlagSvg from "../components/FlagSvg.astro";
import WorkSvg from "../components/WorkSvg.astro";
import HouseSvg from "../components/HouseSvg.astro";
import HandShakeSvg from "../components/HandShakeSvg.astro";
import UsersPlusSvg from "../components/UsersPlusSvg.astro";
import IdSvg from "../components/IdSvg.astro";
import RefreshSvg from "../components/RefreshSvg.astro";

const cards = [
  {
    svg: WorldSvg,
    title: "Visado Nómada Digital",
    description: "Vive y trabaja en España.",
    price: "€500",
    priceDescription: "Incluye preparación completa + tasas.",
  },
  {
    svg: SchoolSvg,
    title: "Estancia por Estudios",
    description: "Estudia legalmente en España.",
    price: "€250",
    priceDescription: "Todo incluido + seguimiento.",
  },
  {
    svg: FamilySvg,
    title: "Reagrupación Familiar",
    description: "Trae a tu familia contigo.",
    price: "€300",
    priceDescription: "Precio completo por persona.",
  },
  {
    svg: FlagSvg,
    title: "Nacionalidad Española",
    description: "Obtén la ciudadanía.",
    price: "€400",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
  {
    svg: WorkSvg,
    title: "Residencia y trabajo",
    description: "Trabaja legalmente por cuenta ajena o propia.",
    price: "€350",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
  {
    svg: HouseSvg,
    title: "Residencia no lucrativa",
    description: "Establécete en España sin trabajar.",
    price: "€400",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
  {
    svg: HandShakeSvg,
    title: "Arraigo familiar",
    description: "Residencia para familiares de nacionales UE.",
    price: "€350",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
  {
    svg: UsersPlusSvg,
    title: "Arraigo social",
    description: "Regulariza tu situación en España.",
    price: "€300",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
  {
    svg: IdSvg,
    title: "NIE / TIE",
    description: "Obtén tu tarjeta de identidad.",
    price: "€500",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
  {
    svg: RefreshSvg,
    title: "Renovaciones",
    description: "Renueva tu permiso de residencia.",
    price: "€250",
    priceDescription: "Desde la solicitud hasta la resolución.",
  },
];
---

<section id="services" class="px-4 pt-16 pb-16 sm:mx-auto sm:max-w-7xl">
  <div class="flex flex-col gap-y-2">
    <h2 class="text-start font-semibold tracking-widest text-secondary">
      TRÁMITES
    </h2>
    <h3 class="text-start text-7xl font-bold">Precios transparentes</h3>
    <p
      class="mb-4 max-w-4xl text-sm leading-relaxed font-light text-gray-700 sm:mb-12 sm:text-lg md:text-xl lg:mb-16"
    >
      Sin sorpresas. Sin letra pequeña. Precio cerrado que incluye todo.
    </p>
  </div>
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((item) => (
        <Card
          svg={item.svg}
          title={item.title}
          description={item.description}
          price={item.price}
          priceDescription={item.priceDescription}
        />
      ))
    }
  </div>
  <p
    class="pt-8 pb-1 text-start text-base font-light text-pretty text-gray-700 sm:text-2xl md:text-3xl lg:text-4xl"
  >
    ¿No ves tu situación aquí o no sabes cuál es tu situación?
  </p>
  <p class="pb-4 text-base font-medium text-primary">
    Contáctanos de todas formas.
  </p>
  <a
    target="_blank"
    href="https://wa.me/34613168703?text=Hola%20GC%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20c%C3%B3mo%20pueden%20ayudarme."
    class="block w-full max-w-96 rounded-full border border-transparent bg-linear-to-r from-secondary-hover via-secondary/90 to-secondary/85 px-2 py-4 text-center text-base font-bold text-white shadow-lg hover:bg-secondary-hover hover:shadow-2xl focus:ring-2 focus:ring-secondary-hover focus:outline-none sm:px-6 sm:py-5 sm:text-lg"
    >Cuéntanos tu caso</a
  >
</section>
