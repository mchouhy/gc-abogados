---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import ArrowRightSvg from "../components/ArrowRightSvg.astro";
import { SERVICE_ICONS } from "../lib/service-icons";

const SERVICE_ORDER = [
  "visado-nomada-digital",
  "estancia-por-estudios",
  "reagrupacion-familiar",
  "nacionalidad-espanola",
  "residencia-y-trabajo",
  "residencia-no-lucrativa",
  "arraigo-familiar",
  "arraigo-social",
  "nie-tie",
  "renovaciones",
];

const services = (await getCollection("services")).sort(
  (a, b) => SERVICE_ORDER.indexOf(a.id) - SERVICE_ORDER.indexOf(b.id),
);
---

<section id="services" class="px-4 pt-16 pb-32 sm:mx-auto sm:max-w-7xl">
  <div class="flex flex-col gap-y-2">
    <h2 class="text-start font-semibold tracking-widest text-secondary">
      TRÁMITES
    </h2>
    <h3 class="text-start text-2xl font-bold md:text-7xl">
      Precios transparentes
    </h3>
    <p
      class="mb-4 max-w-4xl text-sm leading-relaxed font-light text-gray-700 sm:mb-14 sm:text-lg md:text-xl lg:mb-20"
    >
      Sin sorpresas. Sin letra pequeña. Precio cerrado que incluye todo.
    </p>
  </div>
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service) => {
        const Icon = SERVICE_ICONS[service.data.icon];
        return (
          <Card
            svg={Icon}
            title={service.data.title}
            description={service.data.description}
            price={service.data.price}
            priceDescription={service.data.priceDescription}
          />
        );
      })
    }
  </div>
  <article class="mt-8 flex flex-col md:gap-y-6">
    <p
      class="pt-8 pb-1 text-start text-base font-semibold text-pretty text-primary sm:text-lg md:text-xl lg:text-2xl"
    >
      ¿No ves tu situación aquí o no sabes cuál es?
      <span
        class="block pb-4 text-base font-medium text-secondary sm:inline sm:text-lg md:text-xl lg:text-2xl"
      >
        Contáctanos de todas formas.
      </span>
    </p>
    <a
      target="_blank"
      href="https://wa.me/34613168703?text=Hola%20GC%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20c%C3%B3mo%20pueden%20ayudarme."
      class="group flex w-full items-center justify-center rounded-full border border-transparent bg-linear-to-r from-secondary-hover via-secondary/90 to-secondary/85 px-2 py-4 text-center text-base font-bold text-white shadow-lg hover:bg-secondary-hover hover:shadow-2xl focus:ring-2 focus:ring-secondary-hover focus:outline-none sm:px-6 sm:py-5 sm:text-lg md:max-w-96"
      >Cuéntanos tu caso
      <ArrowRightSvg
        className="ml-2 transition-transform duration-350 group-hover:translate-x-2"
      /></a
    >
  </article>
</section>
