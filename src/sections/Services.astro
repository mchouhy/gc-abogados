---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import ArrowRightSvg from "../components/ArrowRightSvg.astro";
import { SERVICE_ICONS } from "../lib/service-icons";

const SERVICE_ORDER = [
  "visado-nomada-digital",
  "estancia-por-estudios",
  "reagrupacion-familiar",
  "nacionalidad-espanola",
  "residencia-y-trabajo",
  "residencia-no-lucrativa",
  "arraigo-familiar",
  "arraigo-social",
  "nie-tie",
  "renovaciones",
];

const services = (await getCollection("services")).sort(
  (a, b) => SERVICE_ORDER.indexOf(a.id) - SERVICE_ORDER.indexOf(b.id),
);
---

<section id="services" class="px-4 pt-16 pb-32 sm:mx-auto sm:max-w-7xl">
  <div class="flex flex-col gap-y-2">
    <h2
      class="animate-on-scroll text-start text-sm font-semibold tracking-widest text-secondary sm:text-base"
    >
      TRÁMITES
    </h2>
    <h3
      class="animate-on-scroll animate-on-scroll-delay-1 text-start text-2xl font-bold sm:text-3xl md:text-4xl lg:text-5xl"
    >
      Precios transparentes
    </h3>
    <p
      class="animate-on-scroll animate-on-scroll-delay-2 mb-4 max-w-4xl text-sm leading-relaxed font-light text-gray-700 sm:mb-14 sm:text-base md:text-lg lg:text-xl"
    >
      Sin sorpresas. Sin letra pequeña. Precio cerrado que incluye todo.
    </p>
  </div>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
    {
      services.map((service, i) => {
        const Icon = SERVICE_ICONS[service.data.icon];
        const delayClass = `animate-on-scroll-delay-${Math.min((i % 3) + 1, 4)}`;
        return (
          <div class:list={["animate-on-scroll", delayClass]}>
            <Card
              svg={Icon}
              title={service.data.title}
              description={service.data.description}
              price={service.data.price}
              priceDescription={service.data.priceDescription}
            />
          </div>
        );
      })
    }
  </div>
  <article class="mt-8 flex flex-col gap-4 md:gap-y-6">
    <p
      class="animate-on-scroll pt-8 pb-1 text-start text-base font-semibold text-pretty text-primary sm:text-lg md:text-xl lg:text-2xl"
    >
      ¿No ves tu situación aquí o no sabes cuál es?
      <span
        class="block pb-4 text-base font-medium text-secondary sm:inline sm:text-lg md:text-xl lg:text-2xl"
      >
        Contáctanos de todas formas.
      </span>
    </p>
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20c%C3%B3mo%20pueden%20ayudarme."
      class="animate-on-scroll group flex w-full items-center justify-center rounded-full border border-transparent bg-[linear-gradient(to_right,rgba(115,56,56,1),rgba(139,69,69,0.9),rgba(139,69,69,0.85))] px-2 py-4 text-center text-base font-bold text-white shadow-lg transition-all duration-300 hover:bg-secondary-hover hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary sm:px-6 sm:py-5 sm:text-lg md:max-w-96"
      >Cuéntanos tu caso
      <ArrowRightSvg
        className="ml-2 transition-transform duration-300 group-hover:translate-x-2"
      /></a
    >
  </article>
</section>
