---
import Card from "../components/Card.astro";
import WorldSvg from "../components/WorldSvg.astro";
const cards = [
  {
    svg: WorldSvg,
    title: "Visado de Nómada Digital",
    description: "Vive y trabaja en España.",
    price: "€1.200",
    priceDescription: "Incluye preparación completa + tasas.",
  },
  {
    svg: WorldSvg,
    title: "Visado de Estudiante",
    description: "Estudia legalmente en España.",
    price: "€900",
    priceDescription: "Todo incluido + seguimiento.",
  },
  {
    svg: WorldSvg,
    title: "Reagrupación Familiar",
    description: "Trae a tu familia contigo.",
    price: "€1.500",
    priceDescription: "Precio completo por persona.",
  },
];
---

<section class="px-4">
  <div class="flex flex-col gap-y-2">
    <h2 class="font-semibold text-start tracking-wide text-secondary">
      TRÁMITES
    </h2>
    <h3 class="text-3xl font-bold text-start">Precios transparentes</h3>
    <p
      class="text-sm sm:text-lg md:text-xl lg:text-2xl xl:text-3xl text-gray-700 mb-4 sm:mb-12 lg:mb-16 max-w-4xl leading-relaxed font-light"
    >
      Sin sorpresas. Sin letra pequeña. Precio cerrado que incluye todo.
    </p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      cards.map((item) => (
        <Card
          svg={item.svg}
          title={item.title}
          description={item.description}
          price={item.price}
          priceDescription={item.priceDescription}
        />
      ))
    }
  </div>
</section>
