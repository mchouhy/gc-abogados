---
import ArrowRightSvg from "../components/ArrowRightSvg.astro";
---

<section class="px-2 pt-20 pb-44 sm:mx-auto sm:max-w-3xl">
  <div class="flex flex-col items-center gap-y-12 text-center">
    <div class="flex flex-col gap-y-2">
      <h3 class="text-2xl font-bold md:text-7xl">Tu Vida en España</h3>
      <h3 class="text-2xl font-bold text-secondary md:text-7xl">
        Comienza Aquí
      </h3>
    </div>
    <p class="text-lg leading-relaxed font-light text-gray-700 sm:text-2xl">
      Da el primer paso hoy. Estamos aquí para acompañarte en cada momento del
      camino.
    </p>
    <a
      target="_blank"
      href="https://wa.me/34613168703?text=Hola%20GC%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20c%C3%B3mo%20pueden%20ayudarme."
      class="group flex w-full items-center justify-center rounded-full border border-transparent bg-linear-to-r from-secondary-hover via-secondary/90 to-secondary/85 px-2 py-4 text-center text-base font-bold text-white shadow-lg hover:bg-secondary-hover hover:shadow-2xl focus:ring-2 focus:ring-secondary-hover focus:outline-none sm:px-6 sm:py-5 sm:text-lg md:max-w-96"
      >Comenzar ahora
      <ArrowRightSvg
        className="ml-2 transition-transform duration-350 group-hover:translate-x-2"
      /></a
    >
  </div>
</section>
