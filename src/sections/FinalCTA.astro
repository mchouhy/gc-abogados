---
import ArrowRightSvg from "../components/ArrowRightSvg.astro";
---

<section class="px-4 pt-20 pb-32 sm:mx-auto sm:max-w-3xl">
  <div class="flex flex-col items-center gap-y-12 text-center">
    <div class="flex flex-col gap-y-2">
      <h2 class="text-3xl font-bold sm:text-4xl md:text-5xl lg:text-6xl">
        Tu Vida en España
      </h2>
      <h2
        class="text-3xl font-bold text-secondary sm:text-4xl md:text-5xl lg:text-6xl"
      >
        Comienza Aquí
      </h2>
    </div>
    <p class="text-lg leading-relaxed font-light text-gray-700 sm:text-2xl">
      Da el primer paso hoy. Estamos aquí para acompañarte en cada momento del
      camino.
    </p>
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://wa.me/34613168703?text=Hola%20Ataria%20Abogados%2C%20estoy%20interesado%20en%20sus%20servicios.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20c%C3%B3mo%20pueden%20ayudarme."
      class="group flex w-full items-center justify-center rounded-sm border border-transparent bg-[linear-gradient(to_right,rgba(115,56,56,1),rgba(139,69,69,0.9),rgba(139,69,69,0.85))] px-2 py-4 text-center text-base font-bold text-white shadow-lg transition-all duration-300 hover:bg-[#733838] hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b4545] sm:max-w-80 sm:px-6 sm:py-5 sm:text-lg"
      >COMENZAR AHORA
      <ArrowRightSvg
        className="ml-2 transition-transform duration-300 group-hover:translate-x-2"
      /></a
    >
  </div>
</section>
