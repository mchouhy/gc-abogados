---
import MilestoneBullet from "../components/MilestoneBullet.astro";
import MilestoneCard from "../components/MilestoneCard.astro";
import CheckSvg from "../components/CheckSvg.astro";
const results = [
  {
    result: "< 24h",
    description: "Tiempo de respuesta",
    counterTarget: 24,
    counterPrefix: "<",
    counterSuffix: "h",
    counterMode: "count-down",
  },
  {
    result: "95%",
    description: "Casos aprobados",
    counterTarget: 95,
    counterPrefix: "",
    counterSuffix: "%",
    counterMode: "count-up",
  },
  {
    result: "500+",
    description: "Clientes satisfechos",
    counterTarget: 500,
    counterPrefix: "",
    counterSuffix: "+",
    counterMode: "count-up",
  },
  {
    result: "100%",
    description: "Transparencia",
    counterTarget: 100,
    counterPrefix: "",
    counterSuffix: "%",
    counterMode: "count-up",
  },
];

const milestones = [
  {
    svg: CheckSvg,
    title: "Atención personalizada, sin intermediarios",
  },
  {
    svg: CheckSvg,
    title: "Precio cerrado desde el inicio",
  },
  {
    svg: CheckSvg,
    title: "Respuesta el mismo día",
  },
  {
    svg: CheckSvg,
    title: "Transparencia total en todo el proceso",
  },
  {
    svg: CheckSvg,
    title: "Seguimiento constante de tu caso",
  },
];
---

<section class="bg-secondary px-4 py-16 text-white sm:px-6 sm:py-24 lg:px-12 lg:py-32">
  <div
    class="grid grid-cols-1 items-center gap-10 sm:mx-auto sm:max-w-7xl sm:grid-cols-2 sm:gap-12"
  >
    <aside>
      <h2
        class="animate-on-scroll text-2xl font-bold sm:text-3xl md:text-4xl lg:text-5xl"
      >
        No eres un Número. Eres una Persona.
      </h2>
      <p
        class="animate-on-scroll animate-on-scroll-delay-1 my-4 max-w-2xl text-sm leading-relaxed font-light sm:my-8 sm:text-base md:text-lg lg:text-xl"
      >
        Entendemos que detrás de cada trámite hay una vida, sueños y una
        familia. Por eso tratamos cada caso con la dedicación y el respeto que
        mereces.
      </p>
      <div class="flex flex-col gap-3 text-sm font-light sm:text-base md:text-lg">
        {
          milestones.map((item, i) => {
            const delayClass = `animate-on-scroll-delay-${Math.min(i + 1, 4)}`;
            return (
              <div class:list={["animate-on-scroll", delayClass]}>
                <MilestoneBullet svg={item.svg} title={item.title} />
              </div>
            );
          })
        }
      </div>
    </aside>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6">
      {
        results.map((item, i) => {
          const delayClass = `animate-on-scroll-delay-${Math.min(i + 1, 4)}`;
          return (
            <div class:list={["animate-on-scroll", delayClass]}>
              <MilestoneCard
                result={item.result}
                description={item.description}
                counterTarget={item.counterTarget}
                counterPrefix={item.counterPrefix}
                counterSuffix={item.counterSuffix}
                counterMode={item.counterMode}
              />
            </div>
          );
        })
      }
    </div>
  </div>
</section>
