---
const { title } = Astro.props;
const pageTitle = title ? `${title} | Ataria Abogados` : "Ataria Abogados";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://atariaabogados.com");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="description"
      content="Ataria Abogados — Despacho especializado en extranjería e inmigración en España. Residencia, nacionalidad, visados y más. Precio cerrado, respuesta el mismo día."
    />
    <meta
      name="keywords"
      content="Ataria Abogados, abogado extranjería, abogado inmigración España, residencia, nacionalidad española, visado, NIE, TIE, arraigo, reagrupación familiar"
    />
    <meta name="author" content="Ataria Abogados" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ataria Abogados — Extranjería e inmigración en España" />
    <meta property="og:description" content="Despacho especializado en extranjería e inmigración. Residencia, nacionalidad, visados y más. Precio cerrado, respuesta el mismo día." />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Ataria Abogados — Extranjería e inmigración en España" />
    <meta name="twitter:description" content="Despacho especializado en extranjería e inmigración. Precio cerrado, respuesta el mismo día." />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @import "tailwind-animations";
  @import "@fontsource-variable/hubot-sans";

  :root {
    --font-heading: "Hubot Sans Variable", "Hubot Sans", sans-serif;
  }

  body {
    font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    background-color: var(--color-background);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .hero-h1-typo {
    font-family: var(--font-heading);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .hero-h1-typo2 {
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }

    .animate-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
