---
const { svg: Svg, title, description } = Astro.props;
---

<article class="flex flex-col gap-y-10">
  <div class="flex flex-col items-center gap-y-2">
    <div
      class="mb-2 flex h-16 w-16 items-center justify-center rounded-lg bg-secondary"
    >
      <Svg class="stroke-white" />
    </div>
    <h3 class="text-2xl font-bold">{title}</h3>
    <p class="text-center text-base text-gray-600">{description}</p>
  </div>
</article>
