---
const { svg: Svg, title, description, price, priceDescription } = Astro.props;
---

<article
  class="flex flex-col items-start gap-y-8 rounded-2xl border border-gray-400 p-6 shadow-xl transition-shadow duration-300 hover:border-secondary-hover hover:shadow-2xl"
>
  <div>
    <div
      class="mb-2 flex h-10 w-10 items-center justify-center rounded-lg bg-secondary"
    >
      <Svg />
    </div>
    <div>
      <h3 class="text-lg font-semibold">{title}</h3>
      <p class="text-sm text-gray-600">{description}</p>
    </div>
  </div>
  <div class="mt-auto">
    <p class="text-3xl font-bold">
      {price}
      <span class="text-sm font-light text-gray-600">+ IVA</span>
    </p>
    <p class="text-xs text-gray-500">{priceDescription}</p>
  </div>
</article>
