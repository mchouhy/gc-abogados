---
import { render, type CollectionEntry } from "astro:content";
import { SERVICE_ICONS } from "../lib/service-icons";

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
const { title, description, price, priceDescription, category, icon } =
  service.data;
const { Content } = await render(service);
const Icon = SERVICE_ICONS[icon];

const categoryLabels: Record<string, string> = {
  visados: "Visados",
  residencia: "Residencia",
  nacionalidad: "Nacionalidad",
  documentacion: "Documentación",
};
---

<main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
  <a
    href="/#services"
    class="mb-8 inline-flex items-center text-sm font-medium text-secondary hover:underline"
  >
    &larr; Volver a trámites
  </a>

  <span
    class="mb-4 inline-block rounded-full bg-secondary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-secondary"
  >
    {categoryLabels[category] ?? category}
  </span>

  <div class="mb-8 flex items-center gap-4">
    <div
      class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-secondary/10"
    >
      <Icon class="h-7 w-7 stroke-secondary" />
    </div>
    <h1 class="text-3xl font-bold sm:text-5xl">{title}</h1>
  </div>

  <p class="mb-8 text-lg text-gray-600">{description}</p>

  <div class="mb-10 rounded-2xl border border-gray-200 bg-white p-6 sm:p-8">
    <p class="text-4xl font-bold">
      {price}
      <span class="text-sm font-light text-gray-600">+ IVA</span>
    </p>
    <p class="mt-2 text-sm text-gray-500">{priceDescription}</p>
  </div>

  <article class="prose prose-lg max-w-none">
    <Content />
  </article>

  <div class="mt-12 flex flex-col gap-4 sm:flex-row">
    <a
      href="/#services"
      class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-primary transition hover:bg-gray-50"
    >
      &larr; Ver todos los trámites
    </a>
    <a
      target="_blank"
      href="https://wa.me/34613168703?text=Hola%20GC%20Abogados%2C%20estoy%20interesado%20en%20el%20tr%C3%A1mite%20de%20{encodeURIComponent(title)}.%20Me%20gustar%C3%ADa%20saber%20m%C3%A1s."
      class="inline-flex items-center justify-center rounded-full bg-linear-to-r from-secondary-hover via-secondary/90 to-secondary/85 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-secondary-hover hover:shadow-2xl"
    >
      Consultar este trámite
    </a>
  </div>
</main>
