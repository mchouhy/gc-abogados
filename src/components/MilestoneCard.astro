---
const { result, description, counterTarget, counterPrefix, counterSuffix, counterMode } = Astro.props;
---

<div
  class="rounded-2xl border border-white/20 bg-white/10 p-6 backdrop-blur-md sm:rounded-3xl sm:p-8 sm:py-12"
  {...counterTarget !== undefined && {
    "data-counter-target": counterTarget,
    "data-counter-prefix": counterPrefix || "",
    "data-counter-suffix": counterSuffix || "",
    "data-counter-mode": counterMode || "count-up",
  }}
>
  <h3 class="text-3xl font-bold sm:text-5xl">
    <span class="counter-value" data-counter-display>{result}</span>
  </h3>
  <p class="text-base text-white/70 sm:text-lg">{description}</p>
</div>
